# Based Productions website — environment configuration.
# Copy to `.env` for local development. Never commit real `.env` files.
# None of these values are secrets; the app has no API keys or signing secrets.

# Canonical public origin of the site (no trailing slash). Used for canonical
# URLs, the sitemap, and CSRF origin checks on every form submission.
# Local development: http://localhost:4321
SITE_URL=https://basedproductions.xyz

# Directory holding the SQLite database and uploaded media. Must be writable
# and persistent in production (e.g. a mounted volume). Relative paths resolve
# from the process working directory.
DATA_DIR=./data

# Set to "true" ONLY when the app runs behind a reverse proxy you control that
# overwrites X-Forwarded-For. When false, the socket address is used for rate
# limiting. Enabling this without a proxy lets clients spoof their IP.
TRUST_PROXY=false

# Node adapter listen address (standalone mode).
HOST=127.0.0.1
PORT=4321
