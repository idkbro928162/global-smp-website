---
import Breadcrumbs from './Breadcrumbs.astro';

interface Crumb {
  href: string;
  label: string;
}

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  breadcrumbs?: Crumb[];
}

const { title, eyebrow, lead, breadcrumbs = [] } = Astro.props;
---

<header class="page-header">
  <div class="container">
    {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} current={title} />}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="page-header__lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(var(--space-7), 7vw, var(--space-9)) var(--space-7);
    border-bottom: 1px solid var(--color-border);
    background:
      linear-gradient(to bottom, transparent 40%, var(--color-bg)),
      linear-gradient(var(--color-border) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px) 0 0 / 32px 32px;
    background-color: var(--color-bg);
  }

  h1 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    max-width: 20ch;
  }

  .page-header__lead {
    margin-top: var(--space-4);
    max-width: 40rem;
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }
</style>
