---
import Icon from '../components/Icon.astro';
import ProductCard from '../components/products/ProductCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { platformLabel } from '../lib/catalog.ts';
import { formatDate, isoDate } from '../lib/format.ts';
import { getDb } from '../server/db/client.ts';
import { listPublishedOfferings } from '../server/services/offerings.ts';
import { listPublishedProducts } from '../server/services/products.ts';
import { listRecentPublishedReleases } from '../server/services/releases.ts';
import { getContent, getSettings } from '../server/services/site.ts';

const db = getDb();
const content = getContent(db);
const settings = getSettings(db);
const products = listPublishedProducts(db);
const showcase = products.slice(0, 6);
const releases = listRecentPublishedReleases(db, 5);
const hasServices = listPublishedOfferings(db).length > 0;
const storeUrl = settings['links.builtbybit'];
const discordUrl = settings['links.discord'];
---

<SiteLayout title="" description={content['home.hero.body']}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Minecraft plugin development</p>
        <h1 id="hero-title">{content['home.hero.title']}</h1>
        {content['home.hero.body'] && <p class="hero__lead">{content['home.hero.body']}</p>}
        <div class="button-row">
          <a class="button button--primary" href="/products">
            Browse products <Icon name="arrow-right" class="button__icon" />
          </a>
          <a class="button" href="/docs">
            Read the docs
          </a>
        </div>
      </div>

      <aside class="catalogue" aria-labelledby="catalogue-title">
        <div class="catalogue__bar">
          <h2 id="catalogue-title" class="eyebrow eyebrow--plain">
            Catalogue
          </h2>
          <span class="catalogue__count mono">
            {products.length} {products.length === 1 ? 'product' : 'products'}
          </span>
        </div>
        {products.length > 0 ? (
          <ul class="catalogue__list">
            {products.slice(0, 5).map((product) => (
              <li>
                <a href={`/products/${product.slug}`} class={`accent-${product.accent}`}>
                  <span class="catalogue__marker" aria-hidden="true" />
                  <span class="catalogue__name">{product.name}</span>
                  <span class="catalogue__detail mono">
                    {product.latestRelease
                      ? `v${product.latestRelease.version}`
                      : product.availability === 'in_development'
                        ? 'in development'
                        : ''}
                  </span>
                  <span class="catalogue__detail catalogue__platform mono">
                    {product.platforms[0] ? platformLabel(product.platforms[0]) : ''}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="catalogue__empty">
            No products are published yet. When the first plugin is released it will be listed here
            with its version and supported platforms.
          </p>
        )}
        <div class="catalogue__footer">
          <a class="text-link" href="/products">
            View catalogue <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="products-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Products</p>
          <h2 id="products-title">Plugins by Based Productions</h2>
        </div>
        {products.length > 0 && (
          <a class="text-link" href="/products">
            All products <Icon name="arrow-right" size={14} />
          </a>
        )}
      </div>
      {showcase.length > 0 ? (
        <div class="product-grid">
          {showcase.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h3>Products are on the way</h3>
          <p>
            Nothing has been published yet. Products will appear here once they are listed on
            BuiltByBit.
          </p>
        </div>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="channels-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">How it works</p>
          <h2 id="channels-title">Buy, learn, get help</h2>
        </div>
      </div>
      <ol class="channels">
        <li class="channel">
          <span class="channel__index mono" aria-hidden="true">
            01
          </span>
          <h3>Buy on BuiltByBit</h3>
          <p>
            Purchases, downloads and updates are handled by BuiltByBit, the Minecraft marketplace
            where our products are listed.
          </p>
          {storeUrl ? (
            <a class="text-link" href={storeUrl}>
              Visit the store <Icon name="external" size={14} />
              <span class="visually-hidden">(external site)</span>
            </a>
          ) : (
            <p class="channel__pending">Store link coming soon.</p>
          )}
        </li>
        <li class="channel">
          <span class="channel__index mono" aria-hidden="true">
            02
          </span>
          <h3>Read the documentation</h3>
          <p>
            Installation, configuration and usage guides for each product are published here on the
            website.
          </p>
          <a class="text-link" href="/docs">
            Browse docs <Icon name="arrow-right" size={14} />
          </a>
        </li>
        <li class="channel">
          <span class="channel__index mono" aria-hidden="true">
            03
          </span>
          <h3>Get support on Discord</h3>
          <p>Questions and problems are handled through support tickets on our Discord server.</p>
          <a class="text-link" href="/support">
            How support works <Icon name="arrow-right" size={14} />
          </a>
          {!discordUrl && <p class="channel__pending">Discord invite coming soon.</p>}
        </li>
      </ol>
    </div>
  </section>

  {releases.length > 0 && (
    <section class="section" aria-labelledby="releases-title">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">Changelog</p>
            <h2 id="releases-title">Latest releases</h2>
          </div>
          <a class="text-link" href="/changelog">
            Full changelog <Icon name="arrow-right" size={14} />
          </a>
        </div>
        <ul class="release-rows">
          {releases.map((release) => (
            <li>
              <a href={`/products/${release.productSlug}/changelog#v-${release.version}`}>
                <span class="release-rows__product">{release.productName}</span>
                <span class="release-rows__version mono">
                  v{release.version}
                  {release.channel !== 'stable' && (
                    <span class="badge badge--pending">{release.channel}</span>
                  )}
                </span>
                <span class="release-rows__title">{release.title}</span>
                <time class="release-rows__date mono" datetime={isoDate(release.releasedOn)}>
                  {formatDate(release.releasedOn)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {hasServices && (
    <section class="section" aria-labelledby="services-title">
      <div class="container services-teaser">
        <div>
          <p class="eyebrow">Services</p>
          <h2 id="services-title">Development services</h2>
          <p class="muted">See which development services Based Productions currently offers.</p>
        </div>
        <a class="button" href="/services">
          View services <Icon name="arrow-right" class="button__icon" />
        </a>
      </div>
    </section>
  )}
</SiteLayout>

<style>
  .hero {
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    border-bottom: 1px solid var(--color-border);
    background:
      radial-gradient(ellipse at 20% 0%, transparent 30%, var(--color-bg) 75%),
      linear-gradient(var(--color-border) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px) 0 0 / 32px 32px;
    background-color: var(--color-bg);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .hero h1 {
    margin-top: var(--space-4);
    font-size: var(--text-display);
    font-weight: 820;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .hero__lead {
    margin-top: var(--space-5);
    max-width: 36rem;
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }

  .hero .button-row {
    margin-top: var(--space-6);
  }

  .catalogue {
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    min-width: 0;
  }

  .catalogue__bar,
  .catalogue__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
  }

  .catalogue__bar {
    border-bottom: 1px solid var(--color-border);
  }

  .catalogue__footer {
    border-top: 1px solid var(--color-border);
  }

  .catalogue__count {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .catalogue__list {
    list-style: none;
    padding: var(--space-2) 0;
  }

  .catalogue__list a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
  }

  .catalogue__list a:hover {
    background: var(--color-surface-2);
  }

  .catalogue__marker {
    width: 8px;
    height: 8px;
    background: var(--accent);
  }

  .catalogue__name {
    font-weight: 650;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .catalogue__detail {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .catalogue__platform {
    display: none;
  }

  .catalogue__empty {
    padding: var(--space-5) var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .channels {
    display: grid;
    gap: 1px;
    list-style: none;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-border);
    overflow: hidden;
  }

  .channel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    background: var(--color-bg);
  }

  .channel__index {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .channel h3 {
    font-size: var(--text-lg);
  }

  .channel p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .channel .text-link {
    margin-top: auto;
  }

  .channel__pending {
    font-family: var(--font-mono);
    font-size: var(--text-xs) !important;
    color: var(--color-text-subtle) !important;
  }

  .release-rows {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .release-rows li {
    border-bottom: 1px solid var(--color-border);
  }

  .release-rows a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4) var(--space-2);
    text-decoration: none;
  }

  .release-rows a:hover {
    background: var(--color-surface);
  }

  .release-rows__product {
    font-weight: 650;
  }

  .release-rows__version {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .release-rows__title {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .release-rows__date {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    text-align: right;
  }

  .services-teaser {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .services-teaser h2 {
    font-size: var(--text-2xl);
    margin-block: var(--space-2);
  }

  @media (min-width: 40rem) {
    .catalogue__list a {
      grid-template-columns: auto minmax(0, 1fr) auto 5.5rem;
    }

    .catalogue__platform {
      display: block;
      text-align: right;
    }

    .release-rows a {
      grid-template-columns: minmax(8rem, 1.2fr) 11rem minmax(0, 2fr) auto;
      align-items: center;
    }
  }

  @media (min-width: 56rem) {
    .channels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
</style>
