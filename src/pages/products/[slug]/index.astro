---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import Markdown from '../../../components/Markdown.astro';
import AvailabilityBadge from '../../../components/products/AvailabilityBadge.astro';
import ProductArtwork from '../../../components/products/ProductArtwork.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { RELEASE_CHANNELS, platformLabel } from '../../../lib/catalog.ts';
import { formatDate, isoDate } from '../../../lib/format.ts';
import { markdownToText, renderMarkdown } from '../../../lib/markdown.ts';
import { getDb } from '../../../server/db/client.ts';
import { getPublishedProduct } from '../../../server/services/products.ts';
import { listPublishedReleasesForProduct } from '../../../server/services/releases.ts';
import { getSettings } from '../../../server/services/site.ts';

const db = getDb();
const product = getPublishedProduct(db, Astro.params.slug ?? '');
if (!product) return Astro.rewrite('/404');

const settings = getSettings(db);
const releases = listPublishedReleasesForProduct(db, product.id);
const recentReleases = releases.slice(0, 3);
const description = renderMarkdown(product.description, { baseLevel: 3 });

const docsHref =
  product.docPageCount > 0 ? `/docs/${product.slug}` : product.externalDocsUrl || null;
const docsExternal = product.docPageCount === 0 && Boolean(product.externalDocsUrl);
const supportHref = product.supportUrl || settings['links.discord'] || '/support';
const supportExternal = Boolean(product.supportUrl || settings['links.discord']);
const metaDescription =
  product.tagline || markdownToText(product.description) || `${product.name} by Based Productions.`;
const latest = product.latestRelease;
---

<SiteLayout title={product.name} description={metaDescription} image={product.artwork?.url}>
  <article class={`accent-${product.accent}`}>
    <header class="product-hero">
      <div class="container">
        <Breadcrumbs items={[{ href: '/products', label: 'Products' }]} current={product.name} />
        <div class="product-hero__grid">
          <div class="product-hero__art">
            <ProductArtwork
              name={product.name}
              accent={product.accent}
              artwork={product.artwork}
              sizes="(min-width: 64rem) 50vw, 100vw"
              eager
            />
          </div>
          <div class="product-hero__info">
            <div class="product-hero__badges">
              <AvailabilityBadge availability={product.availability} />
              {latest && (
                <span class="badge">
                  v{latest.version}
                  {latest.channel !== 'stable' && ` · ${RELEASE_CHANNELS[latest.channel]}`}
                </span>
              )}
            </div>
            <h1>{product.name}</h1>
            {product.tagline && <p class="product-hero__tagline">{product.tagline}</p>}

            <div class="button-row product-hero__actions">
              {product.builtbybitUrl ? (
                <a class="button button--primary" href={product.builtbybitUrl}>
                  {/* Only available products are promoted as purchasable. */}
                  {product.availability === 'available'
                    ? 'Buy on BuiltByBit'
                    : 'View on BuiltByBit'}
                  <Icon name="external" class="button__icon" />
                  <span class="visually-hidden">(external site)</span>
                </a>
              ) : (
                <p class="purchase-note">
                  {product.availability === 'in_development'
                    ? 'Not available to buy yet.'
                    : 'The BuiltByBit listing link has not been published yet.'}
                </p>
              )}
              {docsHref && (
                <a class="button" href={docsHref}>
                  <Icon name="book" class="button__icon" /> Documentation
                  {docsExternal && <span class="visually-hidden">(external site)</span>}
                </a>
              )}
              <a class="button" href={supportHref}>
                <Icon name="chat" class="button__icon" /> Get support
                {supportExternal && <span class="visually-hidden">(external site)</span>}
              </a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="container product-body">
      <aside class="product-specs" aria-labelledby="specs-title">
        <h2 id="specs-title" class="eyebrow">
          At a glance
        </h2>
        <dl>
          <div>
            <dt>Latest version</dt>
            <dd>
              {latest ? (
                <>
                  <span class="mono">{latest.version}</span>
                  <span class="spec-note">
                    {RELEASE_CHANNELS[latest.channel]} ·{' '}
                    <time datetime={isoDate(latest.releasedOn)}>
                      {formatDate(latest.releasedOn)}
                    </time>
                  </span>
                </>
              ) : (
                <span class="subtle">No releases published yet</span>
              )}
            </dd>
          </div>
          {product.minecraftVersions.length > 0 && (
            <div>
              <dt>Minecraft</dt>
              <dd>
                <ul class="tags">
                  {product.minecraftVersions.map((v) => (
                    <li class="mono">{v}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          {product.platforms.length > 0 && (
            <div>
              <dt>Platforms</dt>
              <dd>
                <ul class="tags">
                  {product.platforms.map((p) => (
                    <li>{platformLabel(p)}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          {product.javaVersion && (
            <div>
              <dt>Java</dt>
              <dd class="mono">{product.javaVersion}</dd>
            </div>
          )}
          {product.launchedOn && (
            <div>
              <dt>First released</dt>
              <dd>
                <time datetime={product.launchedOn}>{formatDate(product.launchedOn)}</time>
              </dd>
            </div>
          )}
        </dl>
        <ul class="product-links">
          {releases.length > 0 && (
            <li>
              <a href={`/products/${product.slug}/changelog`}>
                Changelog <span class="subtle">({releases.length})</span>
              </a>
            </li>
          )}
          {docsHref && (
            <li>
              <a href={docsHref}>
                Documentation{docsExternal && <span class="visually-hidden"> (external site)</span>}
              </a>
            </li>
          )}
          <li>
            <a href="/support">Support</a>
          </li>
        </ul>
      </aside>

      <div class="product-content">
        {product.description.trim() && (
          <section aria-labelledby="overview-title">
            <h2 id="overview-title">Overview</h2>
            <Markdown html={description.html} />
          </section>
        )}

        {product.features.length > 0 && (
          <section aria-labelledby="features-title">
            <h2 id="features-title">Features</h2>
            <ul class="features">
              {product.features.map((feature) => (
                <li>
                  <h3>{feature.title}</h3>
                  {feature.body && <p>{feature.body}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {product.screenshots.length > 0 && (
          <section aria-labelledby="screenshots-title">
            <h2 id="screenshots-title">Screenshots</h2>
            <ul class="screenshots">
              {product.screenshots.map((shot) => (
                <li>
                  <a href={shot.url}>
                    <img
                      src={shot.smallUrl}
                      width={Math.min(640, shot.width)}
                      height={Math.round((Math.min(640, shot.width) / shot.width) * shot.height)}
                      alt={shot.alt || `${product.name} screenshot`}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="visually-hidden">(view full size)</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {recentReleases.length > 0 && (
          <section aria-labelledby="releases-title">
            <div class="section-row">
              <h2 id="releases-title">Recent releases</h2>
              <a class="text-link" href={`/products/${product.slug}/changelog`}>
                Full changelog <Icon name="arrow-right" size={14} />
              </a>
            </div>
            <ol class="release-summary">
              {recentReleases.map((release) => (
                <li>
                  <a href={`/products/${product.slug}/changelog#v-${release.version}`}>
                    <span class="mono">v{release.version}</span>
                    {release.channel !== 'stable' && (
                      <span class="badge badge--pending">{RELEASE_CHANNELS[release.channel]}</span>
                    )}
                    <span class="release-summary__title">{release.title}</span>
                    <time class="subtle mono" datetime={isoDate(release.releasedOn)}>
                      {formatDate(release.releasedOn)}
                    </time>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}

        {!product.description.trim() && product.features.length === 0 && (
          <div class="empty-state">
            <p>A full description of {product.name} has not been published yet.</p>
          </div>
        )}

        <section class="support-box" aria-labelledby="help-title">
          <h2 id="help-title">Need help with {product.name}?</h2>
          <p>
            Support happens on our Discord server.
            {docsHref && ' The documentation covers installation and configuration.'}
          </p>
          <div class="button-row">
            <a class="button" href="/support">
              How support works
            </a>
          </div>
        </section>
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  .product-hero {
    padding-block: var(--space-6) var(--space-7);
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(to bottom, var(--accent-deep), var(--color-bg) 70%);
  }

  .product-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }

  .product-hero__art {
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .product-hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .product-hero h1 {
    margin-top: var(--space-4);
    font-size: var(--text-3xl);
    font-weight: 820;
    letter-spacing: -0.03em;
  }

  .product-hero__tagline {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 34rem;
  }

  .product-hero__actions {
    margin-top: var(--space-6);
    align-items: center;
  }

  .purchase-note {
    flex-basis: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .product-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-9);
  }

  .product-specs dl {
    margin-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .product-specs dl > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .product-specs dt {
    color: var(--color-text-subtle);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }

  .tags li {
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    line-height: 1.8;
  }

  .product-links {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  .spec-note {
    display: block;
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .product-links a {
    display: flex;
    gap: 0.35em;
    min-height: 2.25rem;
    align-items: center;
    color: var(--color-text-muted);
  }

  .product-links a:hover {
    color: var(--color-text);
  }

  .product-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
  }

  .product-content h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .section-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .section-row h2 {
    margin-bottom: 0;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1px;
    list-style: none;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-border);
    overflow: hidden;
  }

  .features li {
    padding: var(--space-5);
    background: var(--color-bg);
  }

  .features h3 {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    font-size: var(--text-base);
  }

  .features h3::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--accent);
    transform: translateY(-0.15em);
  }

  .features p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .screenshots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .screenshots a {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .screenshots img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .release-summary {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .release-summary li {
    border-bottom: 1px solid var(--color-border);
  }

  .release-summary a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-3) var(--space-2);
    text-decoration: none;
  }

  .release-summary a:hover {
    background: var(--color-surface);
  }

  .release-summary__title {
    flex: 1 1 12rem;
    color: var(--color-text-muted);
  }

  .support-box {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .support-box h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .support-box p {
    color: var(--color-text-muted);
  }

  .support-box .button-row {
    margin-top: var(--space-4);
  }

  @media (min-width: 64rem) {
    .product-hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }

    .product-body {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: start;
    }

    .product-specs {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
    }

    .product-content {
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>
