---
import StaffLayout from '../../layouts/StaffLayout.astro';
import { formatDate, formatDateTime } from '../../lib/format.ts';
import { can } from '../../server/auth/authorization.ts';
import { getDb } from '../../server/db/client.ts';
import { getDashboard } from '../../server/services/dashboard.ts';
import { getSettings } from '../../server/services/site.ts';
import { requirePermission } from '../../server/staff/page.ts';

const actor = requirePermission(Astro, 'panel.access');
const db = getDb();
const data = getDashboard(db, actor);
const discordUrl = getSettings(db)['links.discord'];

const quickActions = [
  { href: '/staff/products/new', label: 'New product', show: can(actor, 'products.manage') },
  { href: '/staff/releases/new', label: 'New release', show: can(actor, 'releases.manage') },
  { href: '/staff/docs/new', label: 'New doc page', show: can(actor, 'docs.manage') },
  { href: '/staff/media', label: 'Upload image', show: can(actor, 'media.manage') },
].filter((action) => action.show);
---

<StaffLayout title={`Welcome, ${actor.displayName}`}>
  <Fragment slot="actions">
    {quickActions.map((action) => (
      <a class="button button--small" href={action.href}>
        {action.label}
      </a>
    ))}
  </Fragment>

  <div class="dashboard">
    {data.counts.length > 0 && (
      <section aria-labelledby="content-title">
        <h2 id="content-title" class="dashboard__heading">
          Content
        </h2>
        <ul class="counts">
          {data.counts.map((count) => (
            <li>
              <a href={count.href}>
                <span class="counts__label">{count.label}</span>
                <span class="counts__value">{count.value.published}</span>
                <span class="counts__meta">
                  published · {count.value.draft} draft{count.value.draft === 1 ? '' : 's'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section aria-labelledby="checklist-title">
      <h2 id="checklist-title" class="dashboard__heading">
        Setup checklist
      </h2>
      {data.checklist.length > 0 ? (
        <ul class="checklist">
          {data.checklist.map((item) => (
            <li class={`notice notice--${item.tone === 'warning' ? 'warning' : 'info'}`}>
              <span>{item.message}</span>
              {item.href && (
                <a class="text-link" href={item.href}>
                  {item.linkLabel}
                </a>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="notice notice--success">Nothing needs attention right now.</p>
      )}
    </section>

    <div class="dashboard__columns">
      {data.recentReleases && (
        <section class="card" aria-labelledby="releases-title">
          <h2 id="releases-title">Latest published releases</h2>
          {data.recentReleases.length > 0 ? (
            <ul class="simple-list">
              {data.recentReleases.map((release) => (
                <li>
                  <span>
                    {release.productName} <span class="mono">{release.version}</span>
                  </span>
                  <span class="subtle mono">{formatDate(release.releasedOn)}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">No releases have been published yet.</p>
          )}
        </section>
      )}

      {data.recentActivity && (
        <section class="card" aria-labelledby="activity-title">
          <h2 id="activity-title">Recent activity</h2>
          {data.recentActivity.length > 0 ? (
            <ul class="simple-list">
              {data.recentActivity.map((event) => (
                <li>
                  <span>
                    <span class="mono">{event.action}</span>
                    {event.targetLabel && <span class="muted"> · {event.targetLabel}</span>}
                    <span class="subtle"> by {event.actorLabel}</span>
                  </span>
                  <span class="subtle mono nowrap">{formatDateTime(event.at)}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">No activity recorded yet.</p>
          )}
          <p class="card__footer">
            <a class="text-link" href="/staff/audit">
              Full audit log
            </a>
          </p>
        </section>
      )}

      <section class="card" aria-labelledby="support-title">
        <h2 id="support-title">Customer support</h2>
        <p class="muted">
          Customer support is handled in the Based Productions Discord server, not in this panel.
          Tickets, conversations and customer data stay in Discord.
        </p>
        {discordUrl ? (
          <p class="card__footer">
            <a class="text-link" href={discordUrl}>
              Open the Discord server
            </a>
          </p>
        ) : (
          <p class="subtle card__footer">The Discord invite link is not configured yet.</p>
        )}
      </section>
    </div>
  </div>
</StaffLayout>

<style>
  .dashboard {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }

  .dashboard__heading {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .counts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .counts a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
  }

  .counts a:hover {
    border-color: var(--color-border-strong);
  }

  .counts__label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .counts__value {
    font-size: var(--text-2xl);
    font-weight: 800;
    line-height: 1.1;
  }

  .counts__meta {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .checklist {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .checklist li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .dashboard__columns {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: start;
  }

  .dashboard__columns .card + .card {
    margin-top: 0;
  }

  .simple-list {
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }

  .simple-list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .simple-list li:last-child {
    border-bottom: 0;
  }

  /* Flex items default to min-width: auto; let long names wrap instead of overflowing. */
  .checklist li > span,
  .simple-list li > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .card__footer {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .card .muted {
    font-size: var(--text-sm);
  }
</style>
