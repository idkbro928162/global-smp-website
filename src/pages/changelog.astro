---
import PageHeader from '../components/PageHeader.astro';
import ReleaseEntry from '../components/products/ReleaseEntry.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDb } from '../server/db/client.ts';
import { listRecentPublishedReleases } from '../server/services/releases.ts';

const LIMIT = 50;
const releases = listRecentPublishedReleases(getDb(), LIMIT);
---

<SiteLayout title="Changelog" description="Recent releases across all Based Productions products.">
  <PageHeader
    eyebrow="Changelog"
    title="Recent releases"
    lead="New versions across every Based Productions product, newest first."
  />
  <div class="container changelog">
    {releases.length > 0 ? (
      <>
        {releases.map((release) => (
          <ReleaseEntry release={release} showProduct />
        ))}
        {releases.length === LIMIT && (
          <p class="subtle more">
            Showing the {LIMIT} most recent releases. Each product page links to its full changelog.
          </p>
        )}
      </>
    ) : (
      <div class="empty-state">
        <h2>No releases published yet</h2>
        <p>Release notes will appear here as products are updated.</p>
      </div>
    )}
  </div>
</SiteLayout>

<style>
  .changelog {
    max-width: calc(52rem + 2 * var(--gutter));
    padding-block: var(--space-5) var(--space-9);
  }

  .empty-state {
    margin-top: var(--space-6);
  }

  .more {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
  }
</style>
