---
import Icon from '../components/Icon.astro';
import Markdown from '../components/Markdown.astro';
import PageHeader from '../components/PageHeader.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { renderMarkdown } from '../lib/markdown.ts';
import { getDb } from '../server/db/client.ts';
import { getContent, getSettings } from '../server/services/site.ts';

const db = getDb();
const content = getContent(db);
const settings = getSettings(db);
const discordUrl = settings['links.discord'];
const storeUrl = settings['links.builtbybit'];
const email = settings['contact.email'];
const intro = renderMarkdown(content['support.intro'], { baseLevel: 3 });
const checklist = renderMarkdown(content['support.checklist'], { baseLevel: 3 });
---

<SiteLayout
  title="Support"
  description="How to get help with Based Productions products: support tickets on Discord."
>
  <PageHeader eyebrow="Support" title="Getting help" />

  <div class="container support">
    <section class="support-primary" aria-labelledby="discord-title">
      <div>
        <h2 id="discord-title">Support on Discord</h2>
        {content['support.intro'] && <Markdown html={intro.html} compact />}
      </div>
      {discordUrl ? (
        <a class="button button--primary" href={discordUrl}>
          Join the Discord server <Icon name="external" class="button__icon" />
          <span class="visually-hidden">(external site)</span>
        </a>
      ) : (
        <p class="pending" role="note">
          The Discord invite link has not been published yet. It will appear here as soon as it is
          available.
        </p>
      )}
    </section>

    <div class="support-grid">
      {content['support.checklist'] && (
        <section class="support-card" aria-labelledby="checklist-title">
          <h2 id="checklist-title">Before you open a ticket</h2>
          <p class="muted">Including these details helps us answer faster:</p>
          <Markdown html={checklist.html} compact />
        </section>
      )}

      <section class="support-card" aria-labelledby="docs-title">
        <h2 id="docs-title">Documentation</h2>
        <p class="muted">
          Installation, configuration and usage guides are published for each product.
        </p>
        <a class="text-link" href="/docs">
          Browse documentation <Icon name="arrow-right" size={14} />
        </a>
      </section>

      <section class="support-card" aria-labelledby="purchases-title">
        <h2 id="purchases-title">Purchases and downloads</h2>
        <p class="muted">
          Products are bought and downloaded through BuiltByBit. Your purchased products are
          available from your BuiltByBit account.
        </p>
        {storeUrl && (
          <a class="text-link" href={storeUrl}>
            Our BuiltByBit store <Icon name="external" size={14} />
            <span class="visually-hidden">(external site)</span>
          </a>
        )}
      </section>

      {email && (
        <section class="support-card" aria-labelledby="contact-title">
          <h2 id="contact-title">Other enquiries</h2>
          <p class="muted">For business enquiries that are not product support:</p>
          <a class="text-link" href={`mailto:${email}`}>
            {email}
          </a>
        </section>
      )}
    </div>
  </div>
</SiteLayout>

<style>
  .support {
    padding-block: var(--space-7) var(--space-9);
  }

  .support-primary {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-6);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .support-primary h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .pending {
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .support-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .support-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .support-card h2 {
    font-size: var(--text-lg);
  }

  .support-card .muted {
    font-size: var(--text-sm);
  }

  @media (min-width: 56rem) {
    .support-primary {
      grid-template-columns: minmax(0, 1fr) auto;
      padding: var(--space-7);
    }
  }
</style>
